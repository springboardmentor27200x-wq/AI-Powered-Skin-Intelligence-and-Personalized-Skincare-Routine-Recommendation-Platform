# Use PostgreSQL for shared deployments. SQLite is supported for local development.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/skin_intelligence
SECRET_KEY=your secret_key
# Explicit INR per USD conversion used only by the Sephora data-cleaning script.
USD_TO_INR=83.0
# Optional Gemini reranking. Leave blank to use scoring-only recommendations.
GEMINI_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash
